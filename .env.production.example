# ─────────────────────────────────────────────────────────────────────────────
# Production environment for docker-compose.prod.yml
# Copy to .env.production (never commit that file) and fill in every value.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Django Core ─────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=lostandfound.iitrpr.ac.in
FRONTEND_URL=https://lostandfound.iitrpr.ac.in
CORS_ALLOWED_ORIGINS=https://lostandfound.iitrpr.ac.in
CSRF_TRUSTED_ORIGINS=https://lostandfound.iitrpr.ac.in

# HTTPS (nginx terminates TLS). Raise HSTS to 31536000 once the site has worked over HTTPS for a while.
SECURE_HSTS_SECONDS=3600

# ─── Database ─────────────────────────────────────────────────────────────────
# Read by the db container to create the database...
POSTGRES_DB=lostandfound
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# ...and by Django to connect to it. Keep these three equal to the values above.
DATABASE_NAME=lostandfound
DATABASE_USER=postgres
DATABASE_PASSWORD=

# ─── Email (OTP codes, invites, notifications) ───────────────────────────────
# Without working SMTP nobody can register: sign-up depends on the emailed OTP.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@iitrpr.ac.in

# ─── Storage ──────────────────────────────────────────────────────────────────
# local keeps uploads in the media volume served by nginx; s3 or cloudinary need the keys in .env.example
STORAGE_BACKEND=local

# ─── Error monitoring ─────────────────────────────────────────────────────────
# Create a Django project at sentry.io and paste its DSN; leave empty to disable.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ─── Mobile app updates (GET /api/v1/app-config/) ────────────────────────────
MOBILE_MIN_SUPPORTED_VERSION=1.0.0
MOBILE_LATEST_VERSION=1.0.0
# Play Store listing or APK download page shown on the "Update required" screen
MOBILE_UPDATE_URL=
