{
  "expo": {
    "name": "Lost & Found IIT Ropar",
    "slug": "lost-and-found-iitrpr",
    "scheme": "lostandfound",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF7F2",
    "primaryColor": "#047857",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ac.in.iitrpr.lostandfound",
      "infoPlist": {
        "NSCameraUsageDescription": "Lost & Found needs camera access to scan QR stickers on campus belongings and take photos of items.",
        "NSPhotoLibraryUsageDescription": "Lost & Found needs photo library access to attach pictures of lost or found belongings."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#1C1C1E"
      },
      "package": "ac.in.iitrpr.lostandfound",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "lost-and-found-portal-self-omega.vercel.app",
              "pathPrefix": "/scan/"
            },
            {
              "scheme": "https",
              "host": "lostandfound.iitrpr.ac.in",
              "pathPrefix": "/scan/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "versionCode": 2
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Lost & Found to scan QR stickers on campus items."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Lost & Found to access your photos to attach item images."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAF7F2"
        }
      ],
      "./plugins/withReleaseSigning",
      "./plugins/withAccentColor",
      "expo-image",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "apiUrl": "https://lost-and-found-portal-zx3h.onrender.com/api/v1",
      "webUrl": "https://lost-and-found-portal-self-omega.vercel.app"
    }
  }
}
