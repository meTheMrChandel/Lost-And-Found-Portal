# ─── Django Core ─────────────────────────────────────────────────────────────
SECRET_KEY=django-insecure-change-me-in-production-use-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Database ─────────────────────────────────────────────────────────────────
# Choose one: postgres or mysql
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=lostandfound
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=db
DATABASE_PORT=5432

# ─── Redis / Celery ──────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ─── Auth ─────────────────────────────────────────────────────────────────────
# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# OTP
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@iitrpr.ac.in
EMAIL_HOST_PASSWORD=secret

# ─── Storage (S3 / Cloudinary) ───────────────────────────────────────────────
STORAGE_BACKEND=local
# For S3:
# STORAGE_BACKEND=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=ap-south-1
# For Cloudinary:
# STORAGE_BACKEND=cloudinary
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── Firebase (FCM, Phase 8) ──────────────────────────────────────────────────
# FIREBASE_CREDENTIALS_JSON=path/to/serviceAccountKey.json

# ─── Sentry (Phase 10) ────────────────────────────────────────────────────────
# SENTRY_DSN=
