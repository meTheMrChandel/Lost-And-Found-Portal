# ─── Django Core ─────────────────────────────────────────────────────────────
SECRET_KEY=django-insecure-change-me-in-production-use-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Database ─────────────────────────────────────────────────────────────────
# Choose one: postgres or mysql
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=lostandfound
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=db
DATABASE_PORT=5432

# ─── Redis / Celery ──────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ─── Auth ─────────────────────────────────────────────────────────────────────
# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# OTP
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@iitrpr.ac.in
EMAIL_HOST_PASSWORD=secret
# Gmail API instead of SMTP (hosts that block SMTP ports, e.g. Render free plan):
# EMAIL_BACKEND=apps.notifications.email_backends.GmailAPIBackend
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=        # python scripts/gmail_refresh_token.py client_secret.json
# DEFAULT_FROM_EMAIL=you@gmail.com

# ─── Twice-daily batch run (matching + post lifecycle) ───────────────────────
# Celery beat runs it at 09:00 and 21:00 IST; without beat, .github/workflows/scheduled-jobs.yml
# calls POST /api/v1/internal/run-scheduled-jobs/ with this secret (empty disables the endpoint).
# CRON_SECRET=
# MATCHING_BATCH_SIZE=25     # lost reports per matching batch
# BATCH_DELAY_SECONDS=30     # pause between batches

# ─── Storage (S3 / Cloudinary) ───────────────────────────────────────────────
STORAGE_BACKEND=local
# For S3:
# STORAGE_BACKEND=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=ap-south-1
# For Cloudinary:
# STORAGE_BACKEND=cloudinary
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── Firebase (FCM, Phase 8) ──────────────────────────────────────────────────
# FIREBASE_CREDENTIALS_JSON=path/to/serviceAccountKey.json

# ─── Sentry (Phase 10) ────────────────────────────────────────────────────────
# SENTRY_DSN=
